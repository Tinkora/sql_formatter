use crate::error::CoreError;
use crate::format::{self, FormatOptions, KeywordCase, SqlDialect};
use serde::Serialize;

/// Helper: convert CoreError to a JsValue with stable `code` field.
fn core_err(e: CoreError) -> wasm_bindgen::JsValue {
    let obj = js_sys::Object::new();
    js_sys::Reflect::set(&obj, &"code".into(), &e.code().into()).ok();
    js_sys::Reflect::set(&obj, &"message".into(), &e.to_string().into()).ok();
    obj.into()
}

/// Format SQL with the given options. All parameters are passed as primitives
/// so callers don't need to know about Rust types.
///
/// # Arguments
/// * `sql` - The SQL string to format.
/// * `dialect` - One of: "generic", "postgresql", "mysql", "sqlite".
/// * `indent_size` - Number of spaces per indent level (2, 4, or 8).
/// * `keyword_case` - One of: "upper", "lower", "capitalize".
/// * `comma_before` - If true, place commas before items (leading style).
/// * `lines_between_statements` - Blank lines between statements (0-5).
/// * `max_line_width` - Target maximum line width (reserved).
#[allow(clippy::too_many_arguments)]
pub fn wasm_format_sql(
    sql: &str,
    dialect: &str,
    indent_size: u8,
    keyword_case: &str,
    comma_before: bool,
    lines_between_statements: u8,
    max_line_width: u32,
) -> Result<String, wasm_bindgen::JsValue> {
    let dialect = SqlDialect::from_str(dialect).map_err(core_err)?;
    let options = FormatOptions {
        dialect,
        indent_size,
        keyword_case: KeywordCase::from_str(keyword_case),
        comma_before,
        lines_between_statements,
        max_line_width,
    };
    format::format_sql(sql, &options).map_err(core_err)
}

/// Minify SQL to a single line.
pub fn wasm_minify_sql(sql: &str) -> Result<String, wasm_bindgen::JsValue> {
    format::minify_sql(sql).map_err(core_err)
}

/// Validate SQL and return a JSON object with `valid` and `issues` fields.
pub fn wasm_validate_sql(
    sql: &str,
    _dialect: &str,
) -> Result<wasm_bindgen::JsValue, wasm_bindgen::JsValue> {
    let issues = format::validate_sql(sql).map_err(core_err)?;
    let result = serde_json::json!({
        "valid": issues.is_empty(),
        "issues": issues,
    });
    serde_wasm_bindgen::to_value(&result)
        .map_err(|e| wasm_bindgen::JsValue::from_str(&format!("Serialization failed: {e}")))
}

/// Return the list of supported SQL dialects as a JSON array.
pub fn wasm_list_dialects() -> wasm_bindgen::JsValue {
    let dialects = SqlDialect::list_all();
    serde_wasm_bindgen::to_value(&dialects).unwrap_or_default()
}
